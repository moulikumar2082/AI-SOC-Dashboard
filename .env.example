# Flask Configuration
SECRET_KEY=cyber-sec-ops-center-super-secret-key-2026!
FLASK_ENV=development
FLASK_DEBUG=1
PORT=5500

# HTTPS / SSL Configuration (Set to false for standard HTTP mode)
USE_HTTPS=false
SSL_CERT=certs/cert.pem
SSL_KEY=certs/key.pem

# Database Configuration
DATABASE_URL=sqlite:///soc_dashboard.db

# OpenAI API Configuration (Optional: built-in offline fallback AI will run if omitted)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Ollama / Local AI Configuration (Optional alternative)
OLLAMA_HOST=http://localhost:11434
USE_OLLAMA=false
